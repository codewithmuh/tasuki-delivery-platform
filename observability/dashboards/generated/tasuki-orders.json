{
  "id": null,
  "uid": "tasuki-orders",
  "title": "Tasuki orders, outbox & dispatch",
  "description": "Quotes, orders, idempotency, ETA sources, the transactional outbox, dispatch events and matching.",
  "tags": [
    "tasuki",
    "orders"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "version": 1,
  "links": [
    {
      "title": "Tasuki dashboards",
      "type": "dashboards",
      "tags": [
        "tasuki"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://github.com/codewithmuh/tasuki-delivery-platform/blob/main/docs/runbooks/README.md",
      "tooltip": "One runbook per alert",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "description": "tasuki-prod or tasuki-dev. Both share one cluster and one Prometheus; only prod has SLOs.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{namespace=~\"tasuki-.*\"}, namespace)",
        "definition": "label_values(up{namespace=~\"tasuki-.*\"}, namespace)",
        "current": {
          "selected": true,
          "text": "tasuki-prod",
          "value": "tasuki-prod"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Quotes and orders (orders API)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "type": "timeseries",
      "title": "Quotes and orders / min",
      "description": "Quotes by where their ETA came from (dispatch, or the local fallback estimate), and orders created. Each order needs a quote that is less than 2 minutes old, so quotes ≥ orders.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (eta_source) (rate(orders_quotes_created_total{namespace=\"$namespace\"}[$__rate_interval])) * 60",
          "legendFormat": "quotes ({{eta_source}} ETA)",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(orders_created_total{namespace=\"$namespace\"}[$__rate_interval])) * 60",
          "legendFormat": "orders created",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/min",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "type": "timeseries",
      "title": "Order status changes / min",
      "description": "Transitions of the order state machine (design §8), counted after their transaction commits: confirmed → dispatching → assigned → picked_up → delivered, or cancelled / failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(orders_status_transitions_total{namespace=\"$namespace\"}[$__rate_interval])) * 60",
          "legendFormat": "{{status}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/min",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "type": "stat",
      "title": "Orders per quote",
      "description": "Orders created divided by quotes issued in the window. Below 1 is normal (merchants compare quotes, quotes expire after 2 minutes); a sudden drop with steady quotes means order creation is failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(orders_created_total{namespace=\"$namespace\"}[$__rate_interval])) / sum(rate(orders_quotes_created_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "orders per quote",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "type": "timeseries",
      "title": "Idempotent replays / min",
      "description": "Order creations answered from a stored idempotency record: a client retried with the same Idempotency-Key after a timeout or 5xx, and got the original 201 instead of a second order. Replays rise when the API is slow; they prove retries are safe, not that something broke.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(orders_idempotent_replays_total{namespace=\"$namespace\"}[$__rate_interval])) * 60",
          "legendFormat": "replays",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/min",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "type": "timeseries",
      "title": "ETA fallback ratio (orders and dispatch)",
      "description": "orders: quotes that used the local estimate (straight line × 1.35 at 15 km/h + prep time) because dispatch's GET /v1/eta did not answer within 300 ms. dispatch: ETAs that used the straight-line fallback because OSRM failed. ETAFallbackHigh opens a ticket above 10 % (dashed line).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(orders_quotes_created_total{namespace=\"$namespace\", eta_source=\"fallback\"}[$__rate_interval]))\n/ sum(rate(orders_quotes_created_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "orders: quotes without a dispatch ETA",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(dispatch_eta_requests_total{namespace=\"$namespace\", source=\"fallback\"}[$__rate_interval]))\n/ sum(rate(dispatch_eta_requests_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "dispatch: ETAs without OSRM",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "links": [
        {
          "title": "Runbook: eta-fallback",
          "url": "https://github.com/codewithmuh/tasuki-delivery-platform/blob/main/docs/runbooks/eta-fallback.md",
          "targetBlank": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              }
            ]
          },
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "type": "timeseries",
      "title": "ETA fallbacks / min by cause",
      "description": "Why ETAs fell back. orders, by reason: timeout (dispatch slower than 300 ms), unavailable (connection refused, DNS, 5xx), bad_response. dispatch: ETA requests by source, osrm or fallback.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (rate(orders_eta_fallbacks_total{namespace=\"$namespace\"}[$__rate_interval])) * 60",
          "legendFormat": "orders: {{reason}}",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (source) (rate(dispatch_eta_requests_total{namespace=\"$namespace\"}[$__rate_interval])) * 60",
          "legendFormat": "dispatch: {{source}}",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "links": [
        {
          "title": "Runbook: eta-fallback",
          "url": "https://github.com/codewithmuh/tasuki-delivery-platform/blob/main/docs/runbooks/eta-fallback.md",
          "targetBlank": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/min",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
