      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Order API SLIs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "type": "timeseries",
      "title": "Quote and create 5xx ratio vs 0.1 %",
      "description": "The orders availability SLI over the dashboard's window: share of POST /v1/quotes and POST /v1/orders answered with a 5xx. The SLO allows 0.1 % over 28 days (dashed line). The SLOs dashboard shows the burn rates that page.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", service=\"orders\", method=\"POST\", route=~\"/v1/quotes|/v1/orders\", status=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{namespace=\"$namespace\", service=\"orders\", method=\"POST\", route=~\"/v1/quotes|/v1/orders\"}[$__rate_interval]))",
          "legendFormat": "5xx ratio",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Runbook: slo-orders-availability",
          "url": "https://github.com/codewithmuh/tasuki-delivery-platform/blob/main/docs/runbooks/slo-orders-availability.md",
          "targetBlank": true
        },
        {
          "title": "SLOs",
          "url": "/d/tasuki-slos?${__url_time_range}&var-datasource=${datasource}&var-namespace=${namespace}"
