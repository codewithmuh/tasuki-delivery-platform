    {
      "id": 11,
      "type": "row",
      "title": "Outbox relay → orders.events",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "type": "timeseries",
      "title": "Outbox lag (oldest unpublished event)",
      "description": "Age of the oldest outbox row the relay has not published to Kafka; 0 when the outbox is empty. OrdersOutboxLagHigh pages above 60 s for 5 minutes (dashed line): confirmed orders are not reaching dispatch, and the dispatch SLO cannot see them until they do.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(orders_outbox_lag_seconds{namespace=\"$namespace\"})",
          "legendFormat": "lag",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Runbook: orders-outbox-lag",
          "url": "https://github.com/codewithmuh/tasuki-delivery-platform/blob/main/docs/runbooks/orders-outbox-lag.md",
          "targetBlank": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
