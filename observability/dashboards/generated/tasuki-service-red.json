          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", service=\"$service\", route=~\"$route\", route!~\"(GET )?/(healthz|readyz|metrics)\", status=~\"2..\"}[$__rate_interval]))",
          "legendFormat": "2xx",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", service=\"$service\", route=~\"$route\", route!~\"(GET )?/(healthz|readyz|metrics)\", status=~\"3..\"}[$__rate_interval]))",
          "legendFormat": "3xx",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", service=\"$service\", route=~\"$route\", route!~\"(GET )?/(healthz|readyz|metrics)\", status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx",
          "range": true,
          "instant": false,
