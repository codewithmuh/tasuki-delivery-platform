        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", service=\"$service\", route=~\"$route\", route!~\"(GET )?/(healthz|readyz|metrics)\", status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "range": true,
          "instant": false,
          "refId": "D"
