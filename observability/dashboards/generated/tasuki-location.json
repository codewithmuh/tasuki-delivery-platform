{
  "id": null,
  "uid": "tasuki-location",
  "title": "Tasuki location pipeline",
  "description": "GPS points from couriers to Redis and to viewers: throughput, shedding, lag and freshness.",
  "tags": [
    "tasuki",
    "location",
    "fleet"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "version": 1,
  "links": [
    {
      "title": "Tasuki dashboards",
      "type": "dashboards",
      "tags": [
        "tasuki"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://github.com/codewithmuh/tasuki-delivery-platform/blob/main/docs/runbooks/README.md",
      "tooltip": "One runbook per alert",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "description": "tasuki-prod or tasuki-dev. Both share one cluster and one Prometheus; only prod has SLOs.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{namespace=~\"tasuki-.*\"}, namespace)",
        "definition": "label_values(up{namespace=~\"tasuki-.*\"}, namespace)",
        "current": {
          "selected": true,
          "text": "tasuki-prod",
          "value": "tasuki-prod"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "fleet-ingest: GPS points in",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 1
      },
      "type": "timeseries",
      "title": "GPS points / s by result",
      "description": "Every point fleet-ingest received, stacked by what happened to it. accepted: published to Kafka. invalid / future / duplicate: dropped by validation (a device clock more than 30 s ahead counts as future). shed: the whole batch got 503 + Retry-After because Kafka could not take it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (result) (rate(fleet_ingest_points_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Service RED: fleet-ingest",
          "url": "/d/tasuki-service-red?${__url_time_range}&var-datasource=${datasource}&var-namespace=${namespace}&var-service=fleet-ingest"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:points/s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 10,
        "y": 1
      },
      "type": "timeseries",
      "title": "Batches shed with 503 / s by reason",
      "description": "Load shedding (design §10): buffer_full (the producer buffer of 10,000 records is full), timeout (Kafka did not acknowledge within 2 s) or kafka_error. The courier app drops the batch and sends a fresher one, so this path loses points on purpose instead of falling over.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (rate(fleet_ingest_shed_requests_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 17,
        "y": 1
      },
      "type": "timeseries",
      "title": "Points per request (p50, p99)",
      "description": "GPS points in each accepted request. Normally 1. Larger batches mean courier apps were offline or were shed, and are catching up with buffered points.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fleet_ingest_batch_points_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fleet_ingest_batch_points_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Kafka: courier.locations (needs the Kafka Exporter)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "type": "timeseries",
      "title": "fleet-state consumer lag (messages)",
      "description": "Messages on courier.locations that the fleet-state consumer group has not processed yet, from the Kafka Exporter that Strimzi runs. KafkaConsumerLagHigh pages above 7,500 (dashed line, about 10 s of peak traffic): a stopped consumer records no freshness events, so lag is the only signal left. Tracking reads the topic without a consumer group, so it has no lag here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag{namespace=\"$namespace\", topic=\"courier.locations\"})",
          "legendFormat": "{{consumergroup}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Runbook: kafka-consumer-lag",
          "url": "https://github.com/codewithmuh/tasuki-delivery-platform/blob/main/docs/runbooks/kafka-consumer-lag.md",
          "targetBlank": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 7500
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "type": "timeseries",
      "title": "fleet-state lag by partition",
      "description": "The same lag per partition (12 partitions, keyed by courier_id). One partition far behind the others points at one stuck consumer or a hot key; all of them behind points at Redis or capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (partition) (kafka_consumergroup_lag{namespace=\"$namespace\", topic=\"courier.locations\", consumergroup=\"fleet-state\"})",
          "legendFormat": "partition {{partition}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Runbook: kafka-consumer-lag",
          "url": "https://github.com/codewithmuh/tasuki-delivery-platform/blob/main/docs/runbooks/kafka-consumer-lag.md",
          "targetBlank": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "fleet-state: positions in Redis",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "type": "heatmap",
      "title": "Freshness heatmap: received_at → Redis",
      "description": "How long points took from fleet-ingest to Redis, as a heatmap of the fleet_state_freshness_seconds buckets. A healthy pipeline is a bright band under 0.5 s; a band moving up means a consumer falling behind, a smear means Redis retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (le) (increase(fleet_state_freshness_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "range": true,
          "instant": false,
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Runbook: slo-fleet-state-location-freshness",
          "url": "https://github.com/codewithmuh/tasuki-delivery-platform/blob/main/docs/runbooks/slo-fleet-state-location-freshness.md",
          "targetBlank": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s"
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "legend": {
          "show": true
        },
        "filterValues": {
          "le": 1e-09
        }
      }
    },
    {
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "type": "timeseries",
      "title": "Share of points in Redis within 2 s (SLI)",
      "description": "The location-freshness SLI: points written to Redis within 2 s of receipt, out of all live points (Redis rebuilds are not counted). The target is 99 % (dashed line). Below the line, the SLO burns.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(fleet_state_freshness_seconds_bucket{namespace=\"$namespace\", le=\"2.0\"}[$__rate_interval]))\n/ sum(rate(fleet_state_freshness_seconds_count{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "within 2 s",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Runbook: slo-fleet-state-location-freshness",
          "url": "https://github.com/codewithmuh/tasuki-delivery-platform/blob/main/docs/runbooks/slo-fleet-state-location-freshness.md",
          "targetBlank": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.99
              }
            ]
          },
          "max": 1,
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 27
      },
      "type": "stat",
      "title": "Redis rebuilds (time range)",
      "description": "Completed rebuilds of Redis from the last 5 minutes of courier.locations. One per pod start is expected; more mean Redis lost its data (restart without persistence, failover, FLUSHALL).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(fleet_state_rebuilds_total{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "rebuilds",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 4,
        "y": 27
      },
      "type": "stat",
      "title": "Last rebuild took",
      "description": "Duration of the most recent rebuild. Dispatch pauses new assignments until a rebuild finishes, so this is roughly how long matching stopped after Redis was lost (design §10: \"seconds\").",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(fleet_state_last_rebuild_duration_seconds{namespace=\"$namespace\"})",
          "legendFormat": "duration",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "type": "timeseries",
      "title": "Points written / s by result",
      "description": "What fleet-state did with each point. applied: newest for its courier, written. stale: a newer point was already stored (out-of-order delivery is harmless by design). invalid: undecodable, skipped. failed: the write failed for that point.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (result) (rate(fleet_state_points_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:points/s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "type": "timeseries",
      "title": "Couriers swept and history errors / min",
      "description": "swept: couriers removed from the geo sets because they sent nothing for SEEN_WINDOW (60 s): apps closed or phones offline. history errors: batches the history sink could not write. History has the lowest priority (design §10), so these never block Redis.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
