# Settings for the local stack (`make up`). Copy this file first:  cp .env.example .env
# Never commit .env. Every value below is a placeholder for a laptop: obviously fake, published on
# purpose, and good enough to run the stack as-is. Shared and cloud environments get generated
# secrets from AWS Secrets Manager instead (deploy/README.md, "Secrets").
#
# To generate real values:
#   openssl rand -hex 32                                   COURIER_TOKEN_SECRET, TRACKING_TOKEN_SECRET (>= 32 bytes)
#   openssl rand -hex 24                                   ADMIN_TOKEN, ORDERS_DB_PASSWORD (hex: safe inside a URL)
#   openssl rand -base64 48                                DJANGO_SECRET_KEY
#   openssl rand -base64 32 | tr '+/' '-_'                 ORDERS_FIELD_KEY (a Fernet key: url-safe base64 of 32 bytes)
#   or: uv run --directory services/orders python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'

# ---- Optional parts of the stack -----------------------------------------------------------------
# Compose profiles, comma separated: "routing" (OSRM on Tokyo roads; first build downloads ~500 MB and
# takes 10-20 min with 4-6 GB of RAM) and "sim" (the city simulator). Empty: the core stack only.
# `make routing-up` and `make sim-up` start them on demand instead.
COMPOSE_PROFILES=

# Built-in simulator scenario: small (laptop: 2 wards, 50 couriers), normal-weekday, rainy-friday.
SIM_SCENARIO=small

# ---- Every service ---------------------------------------------------------------------------------
LOG_LEVEL=info
# How long a service drains after SIGTERM (Go services; orders is fixed at 20 s).
SHUTDOWN_TIMEOUT=20s

# ---- Secrets (placeholders) ------------------------------------------------------------------------
# PostgreSQL password for the orders database (also inside DATABASE_URL, so keep it URL-safe).
ORDERS_DB_PASSWORD=orders-local-only
# Django's secret key (orders); also keys the drop-off hash.
DJANGO_SECRET_KEY=local-only-django-secret-key-not-for-any-shared-environment
# Fernet key for customer name, phone and address (orders). This one is base64 of 32 "x" bytes.
# Comma-separate several keys to rotate: the first encrypts, all decrypt.
ORDERS_FIELD_KEY=eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHg=
# HS256 secrets shared by orders (issues the tokens) and the Go services (verify them). >= 32 bytes.
COURIER_TOKEN_SECRET=local-only-courier-token-secret-at-least-32-bytes
TRACKING_TOKEN_SECRET=local-only-tracking-token-secret-at-least-32-bytes
# Bearer token for the orders admin API (/v1/admin/*); the simulator seeds merchants and couriers with it.
ADMIN_TOKEN=local-only-admin-token

# ---- Tracking and console --------------------------------------------------------------------------
# Local only: the console's fleet stream (/v1/fleet/stream) needs no token. Set false and set
# FLEET_STREAM_TOKEN to try the production setting (the console has no token field yet).
FLEET_STREAM_PUBLIC=true
FLEET_STREAM_TOKEN=
# Brownout knob: at most one position per courier per viewer per interval (e.g. 10s). 0s = off.
TRACKING_MIN_INTERVAL=0s
# Where the browser finds tracking (the host port of the tracking service).
CONSOLE_TRACKING_BASE_URL=http://localhost:8083

# ---- Host ports of the data stores (change them if 5432, 6379 or 9094 are taken) --------------------
ORDERS_DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
# Kafka for tools on the host: KAFKA_BROKERS=localhost:9094 (containers use kafka:9092).
KAFKA_HOST_PORT=9094
